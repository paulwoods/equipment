# Postgres container superuser. Used only by the postgres container itself and
# admin tasks (backups, ad-hoc SQL) — the application does NOT connect with it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Application database connection. The equipment role and database are created
# by deployment/init-app-db.sh (runs automatically on a fresh postgres volume).
# Generate the password with: openssl rand -base64 24
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/equipment
SPRING_DATASOURCE_USERNAME=equipment
SPRING_DATASOURCE_PASSWORD=change-me

# SMTP / Email
SPRING_MAIL_USERNAME=you@example.com
SPRING_MAIL_PASSWORD=change-me
APP_SMTP_FROM=you@example.com
# Required: address the dashboard summary email is sent to
APP_EMAIL_RECIPIENT=you@example.com
APP_URL=https://localhost.com

# JWT (generate with: openssl rand -base64 48)
APP_JWT_SECRET=change-me-generate-a-long-random-string
APP_JWT_EXPIRATION_MS=3600000

# false for development, true for production
APP_COOKIE_SECURE=false

# Google sign-in (optional). OAuth client ID from the Google Cloud console,
# with this app's origin listed as an Authorized JavaScript origin. Leave blank
# to disable Google sign-in — the login page then offers email/password only.
APP_GOOGLE_CLIENT_ID=

# First-run setup. Required to create the initial admin account: the setup form
# will not create anyone without it, and a deployment with this blank refuses
# setup outright rather than handing the first caller a SYSTEM_ADMIN account.
# Generate with: openssl rand -base64 24
APP_SETUP_TOKEN=change-me-generate-a-random-string

# Login rate limiting (independently per IP and per account)
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCKOUT_DURATION_MS=900000

# First-run setup rate limiting (per IP)
APP_SETUP_MAX_ATTEMPTS=5
APP_SETUP_WINDOW_MS=900000

# Forwarded headers (only enable behind a trusted reverse proxy).
# Set strategy to "native" AND restrict internal proxies to the proxy's IP(s),
# otherwise clients can spoof X-Forwarded-For and bypass rate limiting.
#SERVER_FORWARD_HEADERS_STRATEGY=native
#SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=172\.18\.0\.1

# Caddy (TLS termination)
CADDY_DOMAIN=example.com
CADDY_EMAIL=you@example.com

# deployment
DOCKERHUB_USERNAME= username for docker hub
DOCKERHUB_TOKEN=token for docker hub
DROPLET_HOST=url/ip address of deployment vm
DROPLET_USER=user account used for droplet
DROPLET_SSH_KEY=private key that can connect to droplet
