# postgres connection
POSTGRES_DB=jdbc:postgresql://postgres:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PGDATA=/var/lib/postgresql/18/docker

# SMTP / Email
SPRING_MAIL_USERNAME=you@example.com
SPRING_MAIL_PASSWORD=change-me
APP_SMTP_FROM=you@example.com

# The public URL users visit. Frontend and API are same-origin behind Caddy, so
# this is the base for every user-facing link we email (password reset,
# dashboard). Must match CADDY_DOMAIN.
APP_URL=https://app.example.com

# JWT (generate with: openssl rand -base64 48)
APP_JWT_SECRET=change-me-generate-a-long-random-string
APP_JWT_EXPIRATION_MS=3600000

# false for development, true for production
APP_COOKIE_SECURE=false

# Login rate limiting (per IP + email)
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCKOUT_DURATION_MS=900000

# Forwarded headers (only enable behind a trusted reverse proxy).
# Set strategy to "native" AND restrict internal proxies to the proxy's IP(s),
# otherwise clients can spoof X-Forwarded-For and bypass rate limiting.
#SERVER_FORWARD_HEADERS_STRATEGY=native
#SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=172\.18\.0\.1

# Caddy (TLS termination)
# CADDY_DOMAIN serves the app; CADDY_APEX_DOMAIN serves the holding page and
# exists so Caddy keeps renewing the apex certificate. Both need a site block in
# the Caddyfile — a hostname with no block gets no cert, and browsers show a
# full-page TLS warning rather than a clean error.
CADDY_DOMAIN=app.example.com
CADDY_APEX_DOMAIN=example.com
CADDY_EMAIL=you@example.com

# Leave unset in production: the SPA calls the API with relative URLs, so it is
# always same-origin and CORS never fires. Only needed if the frontend is ever
# served from a different origin than the backend.
# APP_CORS_ALLOWED_ORIGINS=https://app.example.com
