# PostgreSQL (consumed by both the postgres container and the backend)
POSTGRES_USER=equipment
POSTGRES_PASSWORD=change-me
# NOTE: the backend reads POSTGRES_DB as a full JDBC URL, while the postgres
# image reads it as a database name to auto-create. Set it to the JDBC URL
# below; the backend will connect to the default `postgres` database unless
# you create `equipment` yourself (e.g. via an init script in
# /docker-entrypoint-initdb.d).
POSTGRES_DB=jdbc:postgresql://postgres:5432/equipment

# SMTP (Spring Mail + app-level SMTP config)
SPRING_MAIL_USERNAME=your-smtp-user@example.com
SPRING_MAIL_PASSWORD=change-me
APP_SMTP_USER=your-smtp-user@example.com
APP_SMTP_PASS=change-me
APP_SMTP_FROM=no-reply@example.com

# JWT
APP_JWT_SECRET=change-me-generate-a-long-random-string
APP_JWT_EXPIRATION_MS=3600000

# Caddy (TLS termination)
CADDY_DOMAIN=equipment.mrpaulwoods.com
CADDY_EMAIL=mr.paul.woods@gmail.com
